<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>용수철 파동 실험 시뮬레이션 (직접 흔들기)</title>
    <style>
        body { font-family: 'Malgun Gothic', sans-serif; text-align: center; background: #f9f9f9; color: #333; margin: 0; padding: 10px; }
        h2 { margin: 10px 0; }
        .canvas-wrap { display: inline-block; position: relative; }
        canvas { background: white; border: 2px solid #ddd; box-shadow: 0 4px 10px rgba(0,0,0,0.1); border-radius: 8px; touch-action: none; max-width: 100%; height: auto; cursor: grab; }
        canvas:active { cursor: grabbing; }
        .info { margin: 15px auto; max-width: 760px; line-height: 1.6; font-size: 1.05em; text-align: left; padding: 0 15px; }
        .highlight { color: #ff3b30; font-weight: bold; }
        .handle-hint { color: #007aff; font-weight: bold; }
        .controls { margin: 15px auto; max-width: 760px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center; }
        .controls button { background: #007aff; color: white; border: none; padding: 10px 18px; font-size: 1em; border-radius: 6px; cursor: pointer; }
        .controls button:hover { background: #005ecb; }
        .controls button.reset { background: #ff9500; }
        .controls button.auto { background: #34c759; }
        .controls button.auto.on { background: #ff3b30; }
        .controls label { font-size: 0.95em; }
        .controls input[type="range"] { vertical-align: middle; }
        .legend { display: inline-block; margin: 0 8px; font-size: 0.95em; }
        .legend .dot { display: inline-block; width: 14px; height: 14px; border-radius: 50%; vertical-align: middle; margin-right: 4px; }
    </style>
</head>
<body>

    <h2>용수철 파동 실험 시뮬레이션</h2>

    <div class="canvas-wrap">
        <canvas id="waveCanvas" width="800" height="380"></canvas>
    </div>

    <div class="controls">
        <button class="reset" id="btnReset">↺ 파동 초기화</button>
        <button class="auto" id="btnAuto">▶ 자동 흔들기</button>
        <label>자동 진동수:
            <input type="range" id="freqSlider" min="0.02" max="0.2" step="0.005" value="0.08">
            <span id="freqVal">0.080</span>
        </label>
        <label>자동 진폭:
            <input type="range" id="ampSlider" min="10" max="70" step="2" value="45">
            <span id="ampVal">45</span>
        </label>
    </div>

    <div class="info">
        <p>
            <span class="handle-hint">● 파란 손잡이(왼쪽 끝)</span>를 마우스/손가락으로 잡고 <strong>위아래로 흔들면</strong> 파동이 만들어져 오른쪽으로 진행합니다.
        </p>
        <p>
            <span class="highlight">● 빨간 리본</span>을 잡고 <strong>좌우로 끌면</strong> 원하는 위치로 옮길 수 있습니다.
            리본은 파동이 지나가도 옆으로 이동하지 않고 <strong>제자리에서 위아래로만 진동</strong>합니다.
        </p>
        <p>
            ▶ <strong>자동 흔들기</strong> 버튼을 누르면 일정한 진동수·진폭으로 자동으로 파동이 만들어집니다.
            슬라이더로 진동수와 진폭을 바꿔보며 파장 변화를 관찰해 보세요.
        </p>
        <div style="text-align:center;">
            <span class="legend"><span class="dot" style="background:#007aff;"></span>손잡이 (직접 흔드는 지점)</span>
            <span class="legend"><span class="dot" style="background:#ff3b30;"></span>리본 (관찰 지점)</span>
        </div>
    </div>

    <script>
    (function() {
        const canvas = document.getElementById('waveCanvas');
        const ctx = canvas.getContext('2d');

        // ───────── 용수철 및 파동 파라미터 ─────────
        const ORIGIN_X = 50;
        const ORIGIN_Y = 190;
        const L = 700;           // 용수철 전체 길이(픽셀)
        const numTurns = 45;     // 용수철 감은 횟수
        const R = 15;            // 용수철 고리 반경
        const points = 700;      // 샘플링 점 개수
        const dxPerPoint = L / points; // 각 샘플 사이 거리(픽셀)

        // 파동 진행 속도: 한 프레임당 몇 픽셀 진행?
        // 60fps 기준, 1프레임에 약 4픽셀 진행
        const PIXELS_PER_FRAME = 4;
        const POINTS_PER_FRAME = PIXELS_PER_FRAME / dxPerPoint; // 약 4점

        // 손잡이의 과거 변위(y) 기록.
        // index = 몇 "프레임" 전인지. 0 = 현재.
        const historyFrames = Math.ceil(points / POINTS_PER_FRAME) + 20;
        const driverHistory = new Array(historyFrames).fill(0);

        // ───────── 상태 변수 ─────────
        let driverY = 0;          // 현재 손잡이 변위
        let isDraggingHandle = false;
        let isDraggingRibbon = false;
        let ribbonCenter = 0.40;  // 리본의 위치 (0~1, 용수철 길이 비율)
        const ribbonHalfWidth = 0.018; // 리본 굵기(비율)

        let autoMode = false;
        let autoT = 0;
        let autoFreq = 0.08;
        let autoAmp = 45;

        // ───────── DOM ─────────
        const btnReset = document.getElementById('btnReset');
        const btnAuto = document.getElementById('btnAuto');
        const freqSlider = document.getElementById('freqSlider');
        const freqVal = document.getElementById('freqVal');
        const ampSlider = document.getElementById('ampSlider');
        const ampVal = document.getElementById('ampVal');

        freqSlider.addEventListener('input', e => {
            autoFreq = parseFloat(e.target.value);
            freqVal.textContent = autoFreq.toFixed(3);
        });
        ampSlider.addEventListener('input', e => {
            autoAmp = parseFloat(e.target.value);
            ampVal.textContent = autoAmp.toFixed(0);
        });

        btnReset.addEventListener('click', () => {
            for (let i = 0; i < driverHistory.length; i++) driverHistory[i] = 0;
            driverY = 0;
            autoT = 0;
        });

        btnAuto.addEventListener('click', () => {
            autoMode = !autoMode;
            if (autoMode) {
                btnAuto.textContent = '■ 자동 멈춤';
                btnAuto.classList.add('on');
            } else {
                btnAuto.textContent = '▶ 자동 흔들기';
                btnAuto.classList.remove('on');
            }
        });

        // ───────── 좌표 변환 ─────────
        function getCanvasPos(evt) {
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            let clientX, clientY;
            if (evt.touches && evt.touches.length > 0) {
                clientX = evt.touches[0].clientX;
                clientY = evt.touches[0].clientY;
            } else {
                clientX = evt.clientX;
                clientY = evt.clientY;
            }
            return {
                x: (clientX - rect.left) * scaleX,
                y: (clientY - rect.top) * scaleY
            };
        }

        // 손잡이 좌표(현재 변위 적용)
        function getHandleScreenPos() {
            return { x: ORIGIN_X, y: ORIGIN_Y + driverY };
        }
        // 리본 중심 x좌표(스크린)
        function getRibbonScreenX() {
            return ORIGIN_X + ribbonCenter * L;
        }

        // ───────── 입력 처리 ─────────
        function onPointerDown(evt) {
            evt.preventDefault();
            const p = getCanvasPos(evt);

            // 손잡이 hit test (왼쪽 끝 원 영역)
            const h = getHandleScreenPos();
            const dh = Math.hypot(p.x - h.x, p.y - h.y);
            if (dh < 30) {
                isDraggingHandle = true;
                if (autoMode) { // 직접 흔들면 자동모드 해제
                    autoMode = false;
                    btnAuto.textContent = '▶ 자동 흔들기';
                    btnAuto.classList.remove('on');
                }
                driverY = clampDriver(p.y - ORIGIN_Y);
                return;
            }

            // 리본 hit test (리본 영역 박스)
            const ribbonX = getRibbonScreenX();
            const ribbonWidthPx = ribbonHalfWidth * 2 * L;
            if (Math.abs(p.x - ribbonX) < Math.max(25, ribbonWidthPx) &&
                p.y > ORIGIN_Y - 80 && p.y < ORIGIN_Y + 80) {
                isDraggingRibbon = true;
                return;
            }
        }

        function onPointerMove(evt) {
            if (!isDraggingHandle && !isDraggingRibbon) return;
            evt.preventDefault();
            const p = getCanvasPos(evt);

            if (isDraggingHandle) {
                driverY = clampDriver(p.y - ORIGIN_Y);
            } else if (isDraggingRibbon) {
                let ratio = (p.x - ORIGIN_X) / L;
                ratio = Math.max(0.02, Math.min(0.98, ratio));
                ribbonCenter = ratio;
            }
        }

        function onPointerUp(evt) {
            isDraggingHandle = false;
            isDraggingRibbon = false;
        }

        function clampDriver(y) {
            const MAX = 90;
            return Math.max(-MAX, Math.min(MAX, y));
        }

        canvas.addEventListener('mousedown', onPointerDown);
        canvas.addEventListener('mousemove', onPointerMove);
        window.addEventListener('mouseup', onPointerUp);

        canvas.addEventListener('touchstart', onPointerDown, { passive: false });
        canvas.addEventListener('touchmove', onPointerMove, { passive: false });
        canvas.addEventListener('touchend', onPointerUp);
        canvas.addEventListener('touchcancel', onPointerUp);

        // ───────── 파동 계산 ─────────
        // 한 점(샘플 i)의 y 변위 = 손잡이의 과거 변위
        // 몇 "프레임" 전인지 = i * dxPerPoint / PIXELS_PER_FRAME = i / POINTS_PER_FRAME
        function waveYAtPoint(i) {
            const fIdx = i / POINTS_PER_FRAME;
            const i0 = Math.floor(fIdx);
            const frac = fIdx - i0;
            if (i0 >= driverHistory.length - 1) return 0;
            // 선형 보간으로 부드럽게
            const a = driverHistory[i0];
            const b = driverHistory[i0 + 1];
            return a * (1 - frac) + b * frac;
        }

        // ───────── 매 프레임 업데이트 ─────────
        let lastFrameAccumulator = 0;
        function stepHistory() {
            // 자동 모드면 sin파 입력
            if (autoMode) {
                autoT += autoFreq * (2 * Math.PI) / 6; // 적당한 속도
                driverY = autoAmp * Math.sin(autoT);
            } else if (!isDraggingHandle) {
                // 손잡이 놓으면 서서히 0으로 (감쇠)
                driverY *= 0.9;
                if (Math.abs(driverY) < 0.3) driverY = 0;
            }

            // history를 오른쪽으로 한 칸 밀고 맨 앞에 현재 driverY 삽입
            driverHistory.pop();
            driverHistory.unshift(driverY);
        }

        // ───────── 그리기 ─────────
        function draw() {
            stepHistory();

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 평형 기준선
            ctx.strokeStyle = '#e0e0e0';
            ctx.lineWidth = 1;
            ctx.setLineDash([6, 6]);
            ctx.beginPath();
            ctx.moveTo(ORIGIN_X, ORIGIN_Y);
            ctx.lineTo(ORIGIN_X + L, ORIGIN_Y);
            ctx.stroke();
            ctx.setLineDash([]);

            // 진행 방향 화살표
            ctx.strokeStyle = '#999';
            ctx.fillStyle = '#999';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(ORIGIN_X + L - 30, 30);
            ctx.lineTo(ORIGIN_X + L + 10, 30);
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(ORIGIN_X + L + 10, 30);
            ctx.lineTo(ORIGIN_X + L + 2, 25);
            ctx.lineTo(ORIGIN_X + L + 2, 35);
            ctx.closePath();
            ctx.fill();
            ctx.font = '13px sans-serif';
            ctx.fillText('파동 진행 방향', ORIGIN_X + L - 110, 22);

            ctx.save();
            ctx.translate(ORIGIN_X, ORIGIN_Y);

            // ── 1) 회색 용수철 ──
            ctx.beginPath();
            ctx.strokeStyle = '#a0a0a0';
            ctx.lineWidth = 2;

            // 리본 인덱스 범위
            const ribbonStartRatio = ribbonCenter - ribbonHalfWidth;
            const ribbonEndRatio = ribbonCenter + ribbonHalfWidth;
            const ribbonStartIdx = Math.floor(points * ribbonStartRatio);
            const ribbonEndIdx = Math.floor(points * ribbonEndRatio);

            for (let i = 0; i <= points; i++) {
                const theta = (i / points) * Math.PI * 2 * numTurns;
                const x_base = (i / points) * L;
                const y_wave = waveYAtPoint(i);

                const x = x_base + R * Math.cos(theta);
                const y = y_wave + R * Math.sin(theta);

                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();

            // ── 2) 빨간 리본 ──
            ctx.beginPath();
            ctx.strokeStyle = '#ff3b30';
            ctx.lineWidth = 6;
            let first = true;
            for (let i = ribbonStartIdx; i <= ribbonEndIdx; i++) {
                const theta = (i / points) * Math.PI * 2 * numTurns;
                const x_base = (i / points) * L;
                const y_wave = waveYAtPoint(i);
                const x = x_base + R * Math.cos(theta);
                const y = y_wave + R * Math.sin(theta);
                if (first) { ctx.moveTo(x, y); first = false; }
                else ctx.lineTo(x, y);
            }
            ctx.stroke();

            // 리본 중심 표시 (작은 마커)
            const midIdx = Math.floor(points * ribbonCenter);
            const midX = (midIdx / points) * L;
            const midY = waveYAtPoint(midIdx);
            ctx.fillStyle = 'rgba(255, 59, 48, 0.2)';
            ctx.beginPath();
            ctx.arc(midX, midY, 14, 0, Math.PI * 2);
            ctx.fill();

            // 리본 위치 수직 점선 (관찰 지점)
            ctx.strokeStyle = 'rgba(255, 59, 48, 0.35)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(midX, -120);
            ctx.lineTo(midX, 130);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.restore();

            // ── 3) 손잡이 (왼쪽 끝) ──
            const handle = getHandleScreenPos();
            // 손잡이 안내선
            ctx.strokeStyle = 'rgba(0,122,255,0.25)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([3, 3]);
            ctx.beginPath();
            ctx.moveTo(handle.x, ORIGIN_Y - 90);
            ctx.lineTo(handle.x, ORIGIN_Y + 90);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = '#007aff';
            ctx.strokeStyle = 'white';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.arc(handle.x, handle.y, 14, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            // 손잡이 라벨
            ctx.fillStyle = '#007aff';
            ctx.font = 'bold 13px sans-serif';
            ctx.fillText('손잡이', handle.x - 22, handle.y - 22);

            // 리본 라벨
            const ribbonScreenX = ORIGIN_X + midX;
            ctx.fillStyle = '#ff3b30';
            ctx.font = 'bold 13px sans-serif';
            ctx.fillText('리본', ribbonScreenX - 14, ORIGIN_Y - 95);

            // 위치 표시
            ctx.fillStyle = '#666';
            ctx.font = '12px sans-serif';
            ctx.fillText('리본 위치: ' + (ribbonCenter * 100).toFixed(0) + '%',
                        ribbonScreenX - 35, ORIGIN_Y + 115);

            requestAnimationFrame(draw);
        }

        draw();
    })();
    </script>
</body>
</html>
